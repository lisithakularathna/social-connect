# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# OAuth client ID from Google Cloud Console (used to verify Google Sign-In
# id tokens sent to POST /auth/google). Must match the client ID configured
# in the mobile app.
GOOGLE_CLIENT_ID="991770544980-h1jr6bpuq3t064mjk80u6kkd3af14nee.apps.googleusercontent.com"
