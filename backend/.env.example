# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# OAuth client ID from Google Cloud Console (used to verify Google Sign-In
# id tokens sent to POST /auth/google). Must match the client ID configured
# in the mobile app.
GOOGLE_CLIENT_ID="991770544980-h1jr6bpuq3t064mjk80u6kkd3af14nee.apps.googleusercontent.com"

# Secret used to sign login tokens. Use a long random string in any shared or
# deployed environment (e.g. `openssl rand -hex 32`). If unset, an insecure
# development default is used.
JWT_SECRET="change-me-to-a-long-random-string"

# How long login tokens stay valid (e.g. 1d, 7d, 12h). Defaults to 7d.
JWT_EXPIRES_IN="7d"
