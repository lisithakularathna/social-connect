# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# OAuth client ID from Google Cloud Console (used to verify Google Sign-In
# id tokens sent to POST /auth/google). Must match the client ID configured
# in the mobile app.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
